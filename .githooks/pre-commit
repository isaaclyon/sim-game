#!/usr/bin/env bash
# Blocks commits that stage secrets. Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail
if ! command -v gitleaks >/dev/null; then
  echo "pre-commit: gitleaks not installed (brew install gitleaks); refusing to commit unscanned." >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner --log-level warn
