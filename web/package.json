{
  "name": "sim-game-web",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build ../crates/sim-wasm --target web --out-dir ../../web/src/pkg --out-name sim_wasm",
    "dev": "npm run wasm && vite",
    "build": "npm run wasm && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "fix": "biome check --write ."
  },
  "dependencies": {
    "camera-controls": "^3.1.2",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
